{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LaTeX Editor",
  "version": "0.1.0",
  "identifier": "com.latex.editor",
  "build": {
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm start"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LaTeX Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
